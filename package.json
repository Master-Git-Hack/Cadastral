{
	"name": "nextjs-fastapi",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"backend": "./.backend.sh",
		"frontend": "next dev --turbopack --port 8083",
		"format": "concurrently \"black ./api/\" \"prettier --ignore-path ./.prettierignore --config ./.prettierrc.json --write './**/*.{ts,tsx,}'\"",
		"dev": "concurrently \"yarn frontend\" \"yarn backend\"",
		"build": "next build",
		"start": "next start -p 3000",
		"deploy": "concurrently \"yarn build\" \"yarn start\" \"yarn backend\"",
		"lint": "oxlint  --fix --fix-suggestions -c ./.oxlintrc.json --import-plugin "
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "oxlint"
	},
